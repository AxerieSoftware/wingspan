---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

/* Made by `npm run screenshots` in the repo root, light and dark, from the e2e tests' made-up household. */
const shots = import.meta.glob<{ default: ImageMetadata }>("../assets/screenshots/*.png", { eager: true });

interface Props {
	name: string;
	alt: string;
	/** Shown under the image. */
	caption?: string;
}

const { name, alt, caption } = Astro.props;
const shot = (theme: "light" | "dark") => {
	const image = shots[`../assets/screenshots/${name}-${theme}.png`]?.default;
	if (!image) throw new Error(`No ${theme} screenshot named ${name}. Run npm run screenshots.`);
	return image;
};
// Shown at half size, since they're taken at 2x.
const width = (image: ImageMetadata) => Math.min(image.width / 2, 720);
const light = shot("light");
const dark = shot("dark");
---

<figure class="screenshot not-content">
	<Picture src={light} alt={alt} formats={["webp"]} width={width(light)} densities={[1, 2]} pictureAttributes={{ class: "screenshot-light" }} />
	<Picture src={dark} alt={alt} formats={["webp"]} width={width(dark)} densities={[1, 2]} pictureAttributes={{ class: "screenshot-dark" }} />
	{caption && <figcaption>{caption}</figcaption>}
</figure>
