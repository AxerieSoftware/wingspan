---
import { existsSync } from "node:fs";
import { join } from "node:path";
import type { ImageMetadata } from "astro";
import { getImage, Picture } from "astro:assets";

/* Made by `npm run screenshots` in the repo root, light and dark, from the e2e tests' made-up household. */
const shots = import.meta.glob<{ default: ImageMetadata }>("../assets/screenshots/*.png", { eager: true });

interface Props {
	name: string;
	alt: string;
	/** Shown under the image. */
	caption?: string;
	/** A clip made by `npm run videos`, played in place of the screenshot when it was recorded for this build. */
	clip?: string;
}

const { name, alt, caption, clip } = Astro.props;
const shot = (theme: "light" | "dark") => {
	const image = shots[`../assets/screenshots/${name}-${theme}.png`]?.default;
	if (!image) throw new Error(`No ${theme} screenshot named ${name}. Run npm run screenshots.`);
	return image;
};
// Shown at half size, since they're taken at 2x.
const width = (image: ImageMetadata) => Math.min(image.width / 2, 720);
const light = shot("light");
const dark = shot("dark");

// The clips aren't in git: the site's deploy records them, and a local build without them shows the screenshots.
const clipPath = (theme: "light" | "dark") => `/videos/${clip}-${theme}.mp4`;
const hasClip = !!clip && existsSync(join(process.cwd(), "public", clipPath("light"))) && existsSync(join(process.cwd(), "public", clipPath("dark")));
const poster = async (image: ImageMetadata) => (await getImage({ src: image, format: "webp", width: width(image) * 2 })).src;
---

<figure class="screenshot not-content">
	{
		hasClip ? (
			<>
				<video class="screenshot-light" data-clip src={clipPath("light")} poster={await poster(light)} width="720" height="450" muted loop playsinline controls preload="none" aria-label={alt} />
				<video class="screenshot-dark" data-clip src={clipPath("dark")} poster={await poster(dark)} width="720" height="450" muted loop playsinline controls preload="none" aria-label={alt} />
			</>
		) : (
			<>
				<Picture src={light} alt={alt} formats={["webp"]} width={width(light)} densities={[1, 2]} pictureAttributes={{ class: "screenshot-light" }} />
				<Picture src={dark} alt={alt} formats={["webp"]} width={width(dark)} densities={[1, 2]} pictureAttributes={{ class: "screenshot-dark" }} />
			</>
		)
	}
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
	// Clips play like a GIF while in view, but not for visitors who asked for less motion; the controls still let them play one.
	const prefersLessMotion = matchMedia("(prefers-reduced-motion: reduce)");
	const observer = new IntersectionObserver(
		entries => {
			for (const entry of entries) {
				const video = entry.target as HTMLVideoElement;
				// play() rejects when the browser blocks it, which leaves the poster and controls as they are.
				if (entry.isIntersecting && !prefersLessMotion.matches) video.play().catch(() => {});
				else video.pause();
			}
		},
		{ threshold: 0.5 }
	);
	for (const video of document.querySelectorAll<HTMLVideoElement>("video[data-clip]")) observer.observe(video);
</script>
