{
	"name": "wingspan",
	"description": "",
	"private": true,
	"version": "0.7.1",
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"dev:edge": "wxt -b edge",
		"build:all": "run-p --print-label build:chrome build:edge build:firefox build:safari",
		"build:chrome": "wxt build -b chrome",
		"build:edge": "wxt build -b edge",
		"build:firefox": "wxt build -b firefox",
		"build:safari": "wxt build -b safari",
		"zip:all": "run-p --print-label zip:chrome zip:edge zip:firefox zip:safari",
		"zip:chrome": "wxt zip -b chrome",
		"zip:edge": "wxt zip -b edge",
		"zip:firefox": "wxt zip -b firefox",
		"zip:safari": "wxt zip -b safari",
		"check": "run-p --print-label typecheck lint knip test",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"knip": "knip",
		"ensure:classes": "node scripts/ensureClassesExistInMonarch.ts",
		"test": "vitest run",
		"e2e": "wxt build && playwright test --project=e2e",
		"e2e:webkit": "wxt build -b safari && playwright test --project=e2e-webkit",
		"e2e:firefox": "wxt build -b firefox && playwright test --project=e2e-firefox",
		"e2e:refresh": "rm -rf tests/.monarch-snapshot",
		"screenshots": "wxt build && playwright test --project=screenshots",
		"videos": "wxt build && playwright test --project=video",
		"generate:icons": "node scripts/generateIcons.ts",
		"postinstall": "wxt prepare"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"@playwright/test": "^1.65.0",
		"@sveltejs/acorn-typescript": "^1.0.13",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@wxt-dev/module-react": "^1.2.2",
		"acorn": "^8.19.0",
		"graphql": "^17.1.0",
		"knip": "6.44.2",
		"npm-run-all2": "^9.0.4",
		"typescript": "^7.0.2",
		"vite": "8.3.6",
		"vitest": "^5.1.0",
		"wxt": "^0.21.5"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@preact/signals-core": "^1.14.5",
		"@tanstack/query-core": "^5.107.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-error-boundary": "^6.1.6",
		"tailwind-variants": "^4.0.1",
		"temporal-polyfill": "1.0.8",
		"valibot": "^1.5.0"
	}
}
